f = 9.4667e9;
E0 = 50e3;
gamma = 1+|qe|*E0 /(me*c^2);
beta = sqrt(1 - 1/gamma^2);
nps = 1000; #360;
tend = 2e-9;

# zend = 500e-3;
zend = tend * c;#1/f * beta*c;
Qtot = -120 * tend; #-100e-3 * 200e-3 / c;
# rout = 1e-3;
