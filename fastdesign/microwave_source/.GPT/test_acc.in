# setrxydist("beam","u",rout/2,rout);
setrxydist("beam","u",rbeam,2*drbeam);
setphidist("beam","u", 0, 2*PI);
setzdist("beam","u",-0.02,0e-3);
settdist("beam","u",tend/2,tend);
setGdist("beam","u", gamma, 0);


